# ── 单进程模式（推荐）：只填这三行，桥自己轮询 Hermes ──────────────
# Hermes API Key（服务器上的 API_SERVER_KEY）
HERMES_API_KEY=change-me
# Hermes 的地址；同机部署就是本机端口，注意带上 Profile 前缀（如果有）
HERMES_BASE_URL=http://127.0.0.1:8642
# '*' = 广播给所有已注册设备；多实例部署时改成实例标识（如 shanghai）
SERVER_ID=*

# ── 可选 ──────────────────────────────────────────────────────
POLL_MS=5000
INCLUDE_PREVIEW=0
# 桥只监听本机，由反向代理转发；容器里用 0.0.0.0
HOST=127.0.0.1
PORT=8787
DB_PATH=./bridge.db

# ── 双进程模式才需要：桥不持有 Key，由 hermes-agent.mjs 推送 ────────
# BRIDGE_SECRET=openssl-rand-hex-32
