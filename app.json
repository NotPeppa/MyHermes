{
  "expo": {
    "name": "MyHermes",
    "slug": "myhermes",
    "version": "0.1.0",
    "scheme": "myhermes",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "orientation": "default",
    "ios": {
      "bundleIdentifier": "dev.myhermes.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "dev.myhermes.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#0B1120"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0B1120",
          "dark": {
            "backgroundColor": "#0B1120"
          }
        }
      ],
      "expo-router",
      "expo-secure-store",
      [
        "./plugins/withAndroidShortcuts",
        {
          "scheme": "myhermes"
        }
      ],
      "./plugins/withAndroidIconFix",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*",
            "image/*"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
