{
  "expo": {
    "name": "MyHermes",
    "slug": "myhermes",
    "version": "0.1.0",
    "scheme": "myhermes",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "orientation": "default",
    "ios": {
      "bundleIdentifier": "dev.myhermes.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "dev.myhermes.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "./plugins/withAndroidShortcuts",
        {
          "scheme": "myhermes"
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*",
            "image/*"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
