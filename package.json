{
  "name": "myhermes",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts && npm run test:render",
    "mock": "tsx scripts/mock-server.ts",
    "e2e": "tsx scripts/e2e-check.ts",
    "test:render": "tsx --tsconfig tests/tsconfig.render.json --test tests/render.test.tsx tests/p1-render.test.tsx tests/p1-images-render.test.tsx tests/p2-diff-render.test.tsx tests/p2-jobs-render.test.tsx tests/p2-conflict-render.test.tsx tests/android-intents-render.test.tsx"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-share-intent": "^9.0.0",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "^0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react-test-renderer": "^19.3.1",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "react-test-renderer": "^19.3.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2"
  }
}
